# Порт HTTP-сервера внутри контейнера и на хосте.
PORT=8080

# --- TMDB (поиск и метаданные) ---
# Получить: https://www.themoviedb.org/settings/api
# Поддерживается и v3 API Key, и v4 Read Access Token (начинается с eyJ).
# Если не задан, сервер всё равно запустится, а /api/health покажет configured: false.
TMDB_API_KEY=
# Язык метаданных TMDB.
TMDB_LANGUAGE=ru-RU

# --- Prowlarr (поиск раздач) ---
# Пример: http://host.docker.internal:9696 или http://prowlarr:9696
PROWLARR_URL=
# Settings → General → API Key
PROWLARR_API_KEY=

# --- Transmission (загрузки) ---
# Можно указать базу (http://host:9091) или полный RPC-адрес (.../transmission/rpc).
TRANSMISSION_URL=
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
# Каталог загрузок; если пусто — используется настройка самого Transmission.
TRANSMISSION_DOWNLOAD_DIR=

# --- Доступ к приложению ---
# Необязательный общий токен: если задан, все /api/* требуют заголовок
# Authorization: Bearer <значение>. Фронтенд берёт токен из localStorage
# (ключ filmfind.token). Проверка через curl:
#   curl -H "Authorization: Bearer $(cat .env | grep APP_ACCESS_TOKEN | cut -d= -f2)" \
#     http://localhost:8080/api/health
# Строгий секрет без пробелов, длина от 32 символов, например:
#   openssl rand -hex 32
# /api/health остаётся публичным — нужен Docker healthcheck.
# Если оставить пустым — API открыт без токена (только для локальной сети).
APP_ACCESS_TOKEN=

# --- Docker Compose ---
# Имя внешней docker-сети для варианта A в docker-compose.yml.
# DOCKER_NETWORK=media
